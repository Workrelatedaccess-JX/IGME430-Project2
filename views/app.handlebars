<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>RIT Voice</title>
  <link rel="shortcut icon" href="/assets/img/favicon.png"/>
  <link rel="stylesheet" type="text/css" href="/assets/style.css"/>
</head>
<body>
  <header class="siteHeader">
    <a class="logo" href="/feed">
      <span class="logoRit">RIT</span>
      <span class="logoDivider"></span>
      <span class="logoVoice">Voice</span>
    </a>
    <div class="userMenu">
      <span class="userName">{{username}}</span>
      <span class="userSeparator">/</span>
      <a href="/logout">LOG OUT</a>
    </div>
  </header>

  <main id="app"></main>

  <div id="errorBox" class="hidden" role="alert">
    <span id="errorMessage"></span>
  </div>
  <script src="/assets/appBundle.js"></script>
</body>
</html>
